# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////app/db_data/hackersec.db

# ── Ollama LLM ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_NUM_CTX=4096

# ── Adversarial Reasoning Board ───────────────────────────────────────────
# Set to 0 to fall back to the single-pass baseline (ablation runs).
LLM_BOARD_ENABLED=1
# Per-seat model overrides. Leave unset to share one resident copy of
# OLLAMA_MODEL. Pointing the judge at a different family (e.g.
# deepseek-coder-v2:16b) costs ~9 GB more VRAM but removes correlated bias.
# OLLAMA_MODEL_ATTACKER=qwen2.5-coder:14b
# OLLAMA_MODEL_DEFENDER=qwen2.5-coder:14b
# OLLAMA_MODEL_JUDGE=deepseek-coder-v2:16b
LLM_TEMP_ATTACKER=0.6
LLM_TEMP_DEFENDER=0.5
LLM_TEMP_JUDGE=0.0
# Citation-required neutralization: the Defender only wins if the sanitizer it
# quotes is actually present in the analyzed snippet. Set to 0 only to ablate.
LLM_EVIDENCE_RULE=1
# Function-level review (real-world evaluation): the Judge votes this many
# times at this temperature; the share of VULNERABLE votes is the score.
LLM_JUDGE_VOTES=5
LLM_JUDGE_VOTE_TEMP=0.7
# signal = evidence check is recorded as a feature only; override = a SAFE
# majority without a quoted sanitizer is overturned; off = not applied.
LLM_EVIDENCE_MODE=signal
OLLAMA_TIMEOUT=300

# ── Real-world evaluation guards ──────────────────────────────────────────
# Pause (instead of recording failures) while the model is not fully on GPU
# or generates slower than this.
REALWORLD_REQUIRE_GPU=1
REALWORLD_MIN_TOKENS_PER_SEC=3
# Semgrep otherwise starts one worker per core (80 on the DGX).
SEMGREP_JOBS=2

# ── Joern CPG ─────────────────────────────────────────────────────────────
JOERN_BASE_URL=http://joern:8080

# ── Limits ────────────────────────────────────────────────────────────────
MAX_REPO_SIZE_MB=500
ANALYSIS_TIMEOUT_SECONDS=300

# ── GPU (Ollama) ──────────────────────────────────────────────────────────
# Prefer ./start.sh on the DGX instead of setting this by hand.
#   ./start.sh           -> one emptiest GPU
#   ./start.sh --count 2 -> two emptiest GPUs (Ollama shards across them)
#   ./start.sh --all     -> every GPU
# NVIDIA_VISIBLE_DEVICES=all
